<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RULES"
                android:textSize="24sp"
                android:textColor="#00E5A0"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/text_rule_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 rules"
                android:textSize="13sp"
                android:textColor="#666680"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_rule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ ADD"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#00E5A0"
            android:textColor="#0A0A0F" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/text_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No rules yet.\nTap + ADD to create your first automation."
        android:textSize="14sp"
        android:textColor="#555570"
        android:gravity="center"
        android:padding="40dp" />

    <!-- Rules list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_rules"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false" />

</LinearLayout>