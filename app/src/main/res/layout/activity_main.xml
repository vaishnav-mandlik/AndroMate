<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── HEADER ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANDROMATE"
            android:textSize="28sp"
            android:textColor="#00E5A0"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v0.1 — Foundation"
            android:textSize="13sp"
            android:textColor="#666680"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <!-- ── STATUS SECTION ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textSize="11sp"
            android:textColor="#555570"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Accessibility Status Card -->
        <LinearLayout
            android:id="@+id/card_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/dot_accessibility"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Service"
                    android:textSize="14sp"
                    android:textColor="#E4E4EF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_accessibility_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off — Tap to enable in Settings"
                    android:textSize="12sp"
                    android:textColor="#FF4757" />
            </LinearLayout>
        </LinearLayout>

        <!-- Engine Status Card -->
        <LinearLayout
            android:id="@+id/card_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/dot_engine"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Background Engine"
                    android:textSize="14sp"
                    android:textColor="#E4E4EF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_engine_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off — Tap to start"
                    android:textSize="12sp"
                    android:textColor="#FF4757" />
            </LinearLayout>
        </LinearLayout>

        <!-- Battery Status Card -->
        <LinearLayout
            android:id="@+id/card_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/dot_battery"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery Optimization"
                    android:textSize="14sp"
                    android:textColor="#E4E4EF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_battery_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restricted — Tap to fix"
                    android:textSize="12sp"
                    android:textColor="#FF4757" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── TEST ACTIONS ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEST ACTIONS"
            android:textSize="11sp"
            android:textColor="#555570"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_open_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡  RULES ENGINE"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="#00E5A0"
            android:textColor="#0A0A0F"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_read_screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁️  Read Screen Content"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#14141E"
            android:textColor="#E4E4EF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏠  Press Home"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#14141E"
            android:textColor="#E4E4EF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⬅️  Press Back"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#14141E"
            android:textColor="#E4E4EF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_current_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱  Get Current App"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#14141E"
            android:textColor="#E4E4EF"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔  Open Notifications"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#14141E"
            android:textColor="#E4E4EF"
            android:layout_marginBottom="16dp" />

        <!-- ── OUTPUT ── -->
        <TextView
            android:id="@+id/label_output"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTPUT"
            android:textSize="11sp"
            android:textColor="#555570"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:textSize="11sp"
            android:textColor="#00E5A0"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <!-- ── CHECKLIST ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETUP CHECKLIST"
            android:textSize="11sp"
            android:textColor="#555570"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/check_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬜ Enable Accessibility Service"
            android:textSize="14sp"
            android:textColor="#666680"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/check_engine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬜ Start Background Engine"
            android:textSize="14sp"
            android:textColor="#666680"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/check_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬜ Disable Battery Optimization"
            android:textSize="14sp"
            android:textColor="#666680"
            android:layout_marginBottom="16dp" />

        <!-- All Done Banner -->
        <TextView
            android:id="@+id/text_all_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ All systems go! AndroMate is fully operational."
            android:textSize="14sp"
            android:textColor="#00E5A0"
            android:textStyle="bold"
            android:background="@drawable/card_success"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</ScrollView>